/* Класс фраз ответа. Конкретные фразы класса и связанные с ними
   структуры-образцы описаны в phrases/examples/concept_phrase_about_os_file_system.gwf */

concept_phrase_about_os_file_system
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о файловой системе операционной системы]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about operating system file system]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase;
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (фраза о файловой системе операционной системы)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Фраза о файловой системе операционной системы - фраза, сообщающая, какая файловая система используется в указанной операционной системе по умолчанию.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_phrase;
			concept_file_system;
			nrel_default_file_system
		};;
	*);;
