/* Класс фраз ответа (ЛР4). Конкретные фразы и структура-образец —
   в phrases/examples/concept_phrase_about_unsupported_os.scs */

concept_phrase_about_unsupported_os
<- sc_node_class;
=> nrel_main_idtf:
	[фраза об операционной системе с завершённой поддержкой]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about unsupported operating system]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase;
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (фраза об операционной системе с завершённой поддержкой)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Фраза об операционной системе с завершённой поддержкой - фраза, сообщающая, что сопровождение актуального выпуска операционной системы прекращено, и указывающая дату прекращения.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_phrase;
			concept_unsupported_operating_system;
			concept_operating_system_release
		};;
	*);;
