/* Фразы-заглушки класса concept_phrase_about_unknown_os_property (ЛР3).
   Шаблона не имеют: переменных в тексте нет, поэтому агент генерации фраз
   выдаёт текст как есть, не обращаясь к базе знаний. */

concept_phrase_about_unknown_os_property ->
	[К сожалению, в моей базе знаний нет таких сведений об этой операционной системе.]
	(* <- lang_ru;; *);;

concept_phrase_about_unknown_os_property ->
	[Пока я не знаю ответа на этот вопрос об этой операционной системе.]
	(* <- lang_ru;; *);;

