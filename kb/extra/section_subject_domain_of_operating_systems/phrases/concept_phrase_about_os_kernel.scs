/* Класс фраз ответа. Конкретные фразы класса и связанные с ними
   структуры-образцы описаны в phrases/examples/concept_phrase_about_os_kernel.gwf */

concept_phrase_about_os_kernel
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о ядре операционной системы]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about operating system kernel]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase;
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (фраза о ядре операционной системы)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Фраза о ядре операционной системы - фраза, сообщающая, какое ядро используется в указанной операционной системе.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_phrase;
			concept_kernel;
			nrel_kernel
		};;
	*);;
