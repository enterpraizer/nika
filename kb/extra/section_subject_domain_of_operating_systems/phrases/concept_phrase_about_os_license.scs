/* Класс фраз ответа. Конкретные фразы класса и связанные с ними
   структуры-образцы описаны в phrases/examples/concept_phrase_about_os_license.gwf */

concept_phrase_about_os_license
<- sc_node_class;
=> nrel_main_idtf:
	[фраза о лицензии операционной системы]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[phrase about operating system license]
	(* <- lang_en;; *);
<= nrel_inclusion:
	concept_phrase;
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (фраза о лицензии операционной системы)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Фраза о лицензии операционной системы - фраза, сообщающая, по какой лицензии распространяется указанная операционная система.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_phrase;
			concept_software_license;
			nrel_license
		};;
	*);;
