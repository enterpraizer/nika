/* Ядро операционной системы. Не максимальный класс объектов
   исследования: изучается как компонент операционной системы. */

concept_kernel
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[ядро операционной системы]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[operating system kernel]
	(* <- lang_en;; *);
=> nrel_note:
	[Центральная часть операционной системы, постоянно находящаяся
	 в оперативной памяти и выполняющаяся в привилегированном режиме
	 процессора. Ядро управляет процессами, памятью, файловыми
	 системами и устройствами, предоставляя прикладным программам
	 доступ к ресурсам через системные вызовы.]
	(* <- lang_ru;; *);
<= nrel_subdividing:
	...
	(*
		<- sc_node_tuple;;
		-> concept_monolithic_kernel;;
		-> concept_microkernel;;
		-> concept_hybrid_kernel;;
	*);;
