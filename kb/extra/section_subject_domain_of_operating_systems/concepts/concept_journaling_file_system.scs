/* Подкласс файловых систем */

concept_journaling_file_system
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[журналируемая файловая система]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[journaling file system]
	(* <- lang_en;; *);
=> nrel_note:
	[Файловая система, ведущая журнал предстоящих изменений метаданных. Журнал позволяет восстановить непротиворечивое состояние после аварийного отключения питания]
	(* <- lang_ru;; *);
<= nrel_inclusion:
	concept_file_system;;
