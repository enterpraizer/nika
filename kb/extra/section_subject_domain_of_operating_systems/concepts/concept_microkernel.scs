/* Подкласс ядер по архитектуре */

concept_microkernel
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[микроядро]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[microkernel]
	(* <- lang_en;; *);
=> nrel_note:
	[Ядро, в привилегированном режиме которого выполняется лишь минимальный набор функций: управление процессами, памятью и межпроцессным взаимодействием. Остальные подсистемы вынесены в пользовательский режим.]
	(* <- lang_ru;; *);
<= nrel_inclusion:
	concept_kernel;;
