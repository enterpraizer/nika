/* Подкласс операционных систем по назначению */

concept_server_operating_system
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[серверная операционная система]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[server operating system]
	(* <- lang_en;; *);
=> nrel_note:
	[Операционная система, предназначенная для обслуживания запросов других компьютеров сети. Оптимизирована под длительную непрерывную работу, многопользовательский режим и высокую нагрузку]
	(* <- lang_ru;; *);
<= nrel_inclusion:
	concept_operating_system;;
