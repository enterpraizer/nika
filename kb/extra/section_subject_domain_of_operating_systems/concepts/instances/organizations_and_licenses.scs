/* Экземпляры классов разработчика программного обеспечения,
   лицензии и архитектуры процессора */

linus_torvalds
<- concept_software_developer;
=> nrel_main_idtf:
	[Линус Торвальдс]
	(* <- lang_ru;; *);
=> nrel_note:
	[Программист, создавший ядро Linux в 1991 году и остающийся его главным сопровождающим.]
	(* <- lang_ru;; *);;

canonical
<- concept_software_developer;
=> nrel_main_idtf:
	[Canonical]
	(* <- lang_ru;; *);
=> nrel_note:
	[Британская компания, основанная в 2004 году и осуществляющая разработку и коммерческую поддержку дистрибутива Ubuntu.]
	(* <- lang_ru;; *);;

microsoft
<- concept_software_developer;
=> nrel_main_idtf:
	[Microsoft]
	(* <- lang_ru;; *);
=> nrel_note:
	[Корпорация, разрабатывающая семейство операционных систем Windows с 1985 года.]
	(* <- lang_ru;; *);;

apple
<- concept_software_developer;
=> nrel_main_idtf:
	[Apple]
	(* <- lang_ru;; *);
=> nrel_note:
	[Корпорация, разрабатывающая операционные системы macOS и iOS для собственных аппаратных платформ.]
	(* <- lang_ru;; *);;

google
<- concept_software_developer;
=> nrel_main_idtf:
	[Google]
	(* <- lang_ru;; *);
=> nrel_note:
	[Корпорация, ведущая разработку мобильной операционной системы Android с 2005 года.]
	(* <- lang_ru;; *);;

gpl_v2
<- concept_software_license;
=> nrel_main_idtf:
	[GNU GPL версии 2]
	(* <- lang_ru;; *);
=> nrel_note:
	[Свободная лицензия с наследованием: производные произведения обязаны распространяться на тех же условиях с открытым исходным кодом.]
	(* <- lang_ru;; *);;

gpl_v3
<- concept_software_license;
=> nrel_main_idtf:
	[GNU GPL версии 3]
	(* <- lang_ru;; *);
=> nrel_note:
	[Редакция свободной лицензии GPL, выпущенная в 2007 году. Дополнительно ограничивает применение патентов и аппаратных средств, препятствующих замене программ.]
	(* <- lang_ru;; *);;

bsd_license
<- concept_software_license;
=> nrel_main_idtf:
	[лицензия BSD]
	(* <- lang_ru;; *);
=> nrel_note:
	[Разрешительная свободная лицензия, допускающая использование кода в закрытых продуктах при сохранении уведомления об авторстве.]
	(* <- lang_ru;; *);;

proprietary_license
<- concept_software_license;
=> nrel_main_idtf:
	[проприетарная лицензия]
	(* <- lang_ru;; *);
=> nrel_note:
	[Лицензия, сохраняющая исключительные права за правообладателем и запрещающая изучение, изменение и распространение исходного кода.]
	(* <- lang_ru;; *);;

x86_64
<- concept_processor_architecture;
=> nrel_main_idtf:
	[x86-64]
	(* <- lang_ru;; *);
=> nrel_note:
	[Шестидесятичетырёхразрядное расширение архитектуры x86, представленное компанией AMD в 2000 году и сохраняющее совместимость с 32-разрядными программами.]
	(* <- lang_ru;; *);;

arm64
<- concept_processor_architecture;
=> nrel_main_idtf:
	[ARM64]
	(* <- lang_ru;; *);
=> nrel_note:
	[Шестидесятичетырёхразрядная архитектура семейства ARM с сокращённым набором команд. Преобладает в мобильных устройствах благодаря низкому энергопотреблению.]
	(* <- lang_ru;; *);;
