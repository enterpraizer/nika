/* Экземпляры класса "файловая система" */

ext4
<- concept_journaling_file_system;
=> nrel_main_idtf:
	[ext4]
	(* <- lang_ru;; *);
=> nrel_note:
	[Журналируемая файловая система, применяемая по умолчанию в большинстве дистрибутивов Linux. Поддерживает тома размером до одного эксбибайта и экстентную адресацию.]
	(* <- lang_ru;; *);;

ntfs
<- concept_journaling_file_system;
=> nrel_main_idtf:
	[NTFS]
	(* <- lang_ru;; *);
=> nrel_note:
	[Журналируемая файловая система семейства Windows NT. Поддерживает разграничение доступа, сжатие и шифрование данных на уровне файлов.]
	(* <- lang_ru;; *);;

apfs
<- concept_file_system;
=> nrel_main_idtf:
	[APFS]
	(* <- lang_ru;; *);
=> nrel_note:
	[Файловая система корпорации Apple, представленная в 2017 году. Оптимизирована под твердотельные накопители, поддерживает снимки состояния и копирование при записи.]
	(* <- lang_ru;; *);;

fat32
<- concept_file_system;
=> nrel_main_idtf:
	[FAT32]
	(* <- lang_ru;; *);
=> nrel_note:
	[Файловая система с таблицей размещения файлов, не поддерживающая журналирование. Благодаря простоте остаётся общим форматом для съёмных носителей.]
	(* <- lang_ru;; *);;
