/* Экземпляры классов планировщика процессов,
   алгоритма планирования и метода управления памятью */

cfs_scheduler
<- concept_process_scheduler;
=> nrel_main_idtf:
	[Completely Fair Scheduler]
	(* <- lang_ru;; *);
=> nrel_note:
	[Планировщик процессов ядра Linux, применявшийся с версии 2.6.23. Стремится предоставить каждому процессу справедливую долю процессорного времени.]
	(* <- lang_ru;; *);
=> nrel_scheduling_algorithm: cfs_algorithm;;

windows_thread_scheduler
<- concept_process_scheduler;
=> nrel_main_idtf:
	[планировщик потоков Windows]
	(* <- lang_ru;; *);
=> nrel_note:
	[Планировщик ядра Windows NT, распределяющий процессорное время между потоками на основе динамических приоритетов.]
	(* <- lang_ru;; *);
=> nrel_scheduling_algorithm: round_robin;;

cfs_algorithm
<- concept_scheduling_algorithm;
=> nrel_main_idtf:
	[алгоритм справедливого планирования]
	(* <- lang_ru;; *);
=> nrel_note:
	[Алгоритм, выбирающий для выполнения процесс с наименьшим накопленным виртуальным временем работы, что выравнивает доли процессорного времени.]
	(* <- lang_ru;; *);;

round_robin
<- concept_scheduling_algorithm;
=> nrel_main_idtf:
	[круговой алгоритм]
	(* <- lang_ru;; *);
=> nrel_note:
	[Алгоритм кругового планирования: процессы выполняются по очереди, каждому предоставляется фиксированный квант процессорного времени.]
	(* <- lang_ru;; *);;

paging
<- concept_memory_management_method;
=> nrel_main_idtf:
	[страничная организация памяти]
	(* <- lang_ru;; *);
=> nrel_note:
	[Метод управления памятью, при котором адресное пространство делится на страницы фиксированного размера, отображаемые в физические кадры через таблицы страниц.]
	(* <- lang_ru;; *);;

swapping
<- concept_memory_management_method;
=> nrel_main_idtf:
	[подкачка страниц]
	(* <- lang_ru;; *);
=> nrel_note:
	[Метод, при котором редко используемые страницы вытесняются из оперативной памяти на дисковый накопитель и возвращаются обратно по мере обращения к ним.]
	(* <- lang_ru;; *);;

segmentation
<- concept_memory_management_method;
=> nrel_main_idtf:
	[сегментная организация памяти]
	(* <- lang_ru;; *);
=> nrel_note:
	[Метод управления памятью, при котором адресное пространство делится на сегменты переменной длины, соответствующие логическим частям программы.]
	(* <- lang_ru;; *);;
