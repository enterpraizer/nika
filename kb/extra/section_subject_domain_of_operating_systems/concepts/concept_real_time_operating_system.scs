/* Подкласс операционных систем по назначению */

concept_real_time_operating_system
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[операционная система реального времени]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[real-time operating system]
	(* <- lang_en;; *);
=> nrel_note:
	[Операционная система, гарантирующая выполнение задачи в пределах заданного интервала времени. Применяется в промышленной автоматике, авиационике и медицинском оборудовании.]
	(* <- lang_ru;; *);
<= nrel_inclusion:
	concept_operating_system;;
