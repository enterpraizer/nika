/* Класс сообщений, выделяемый классификатором Wit.ai.
   Содержимое nrel_wit_ai_idtf должно посимвольно совпадать
   с именем intent в приложении Wit.ai. */

concept_message_about_developer
<- sc_node_class;
<- concept_intent_possible_class;
=> nrel_main_idtf:
	[сообщение о разработчике]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[message about developer]
	(* <- lang_en;; *);
=> nrel_wit_ai_idtf:
	[about_developer];
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (сообщение о разработчике)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Сообщение о разработчике - атомарное сообщение, содержащее программный продукт, разработчика которого требуется найти.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_atomic_message;
			concept_operating_system;
			concept_software_developer
		};;
	*);;
