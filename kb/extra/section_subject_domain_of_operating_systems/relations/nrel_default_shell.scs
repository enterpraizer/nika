/* Отношение между операционной системой и её командной оболочкой */

nrel_default_shell
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[командная оболочка по умолчанию*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[default shell*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_operating_system;
=> nrel_second_domain: concept_shell;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_operating_system;
				concept_shell
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (командная оболочка по умолчанию*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Командная оболочка по умолчанию* - бинарное ориентированное отношение, связывающее операционную систему и командную оболочку, запускаемую при открытии терминала без дополнительной настройки.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_operating_system;
				concept_shell
			};;
	*);;
