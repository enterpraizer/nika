/* Исследуемое отношение: связывает операционную систему с её ядром */

nrel_kernel
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[ядро системы*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[system kernel*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_operating_system;
=> nrel_second_domain: concept_kernel;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_operating_system;
				concept_kernel
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (ядро системы*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Ядро системы* - бинарное ориентированное отношение,
					 связывающее операционную систему и ядро, которое
					 является её центральным управляющим компонентом.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_operating_system;
				concept_kernel
			};;
	*);;
