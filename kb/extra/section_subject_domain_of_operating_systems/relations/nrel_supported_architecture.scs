/* Отношение между операционной системой и архитектурой процессора */

nrel_supported_architecture
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[поддерживаемая архитектура*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[supported architecture*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_operating_system;
=> nrel_second_domain: concept_processor_architecture;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_operating_system;
				concept_processor_architecture
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (поддерживаемая архитектура*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Поддерживаемая архитектура* - бинарное ориентированное отношение, связывающее операционную систему и архитектуру процессора, для которой существует её официальная сборка.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_operating_system;
				concept_processor_architecture
			};;
	*);;
