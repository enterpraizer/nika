/* Отношение между ядром и методом управления памятью */

nrel_memory_management_method
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[метод управления памятью*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[memory management method*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_kernel;
=> nrel_second_domain: concept_memory_management_method;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_kernel;
				concept_memory_management_method
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (метод управления памятью*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Метод управления памятью* - бинарное ориентированное отношение, связывающее ядро операционной системы и применяемый им способ распределения оперативной памяти между процессами.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_kernel;
				concept_memory_management_method
			};;
	*);;
