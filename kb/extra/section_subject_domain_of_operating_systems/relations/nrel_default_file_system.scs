/* Отношение между операционной системой и основной файловой системой */

nrel_default_file_system
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[файловая система по умолчанию*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[default file system*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_operating_system;
=> nrel_second_domain: concept_file_system;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_operating_system;
				concept_file_system
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (файловая система по умолчанию*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Файловая система по умолчанию* - бинарное ориентированное отношение, связывающее операционную систему и файловую систему, которая создаётся на системном разделе при её штатной установке.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_operating_system;
				concept_file_system
			};;
	*);;
