/* Отношение принадлежности операционной системы к семейству */

nrel_operating_system_family
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[семейство операционных систем*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[operating system family*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_operating_system;
=> nrel_second_domain: concept_operating_system_family;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_operating_system;
				concept_operating_system_family
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (семейство операционных систем*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Семейство операционных систем* - бинарное ориентированное отношение, связывающее операционную систему и семейство, к которому она принадлежит по происхождению и архитектуре.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_operating_system;
				concept_operating_system_family
			};;
	*);;
