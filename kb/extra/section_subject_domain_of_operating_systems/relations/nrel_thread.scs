<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[поток процесса*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[process thread*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_process;
=> nrel_second_domain: concept_thread;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_process;
				concept_thread
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (поток процесса*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Поток процесса* - бинарное ориентированное отношение, связывающее процесс и поток выполнения, созданный в его адресном пространстве.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
