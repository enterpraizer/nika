/* Отношение между операционной системой и поддерживаемыми файловыми системами */

nrel_supported_file_system
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[поддерживаемая файловая система*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[supported file system*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_operating_system;
=> nrel_second_domain: concept_file_system;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_operating_system;
				concept_file_system
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (поддерживаемая файловая система*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Поддерживаемая файловая система* - бинарное ориентированное отношение, связывающее операционную систему и файловую систему, чтение и запись которой она обеспечивает штатными средствами.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_operating_system;
				concept_file_system
			};;
	*);;
