/* Отношение между планировщиком и алгоритмом планирования */

nrel_scheduling_algorithm
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[алгоритм планирования*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[scheduling algorithm*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_process_scheduler;
=> nrel_second_domain: concept_scheduling_algorithm;
=> nrel_definitional_domain:
	...
	(*
		<= nrel_combination:
			{
				concept_process_scheduler;
				concept_scheduling_algorithm
			};;
	*);
<- rrel_key_sc_element:
	...
	(*
		=> nrel_main_idtf:
			[Опр. (алгоритм планирования*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			...
			(*
				-> rrel_example:
					[Алгоритм планирования* - бинарное ориентированное отношение, связывающее планировщик процессов и алгоритм, по которому он выбирает очередной процесс для выполнения.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants:
			{
				concept_process_scheduler;
				concept_scheduling_algorithm
			};;
	*);;
