/* Отношение введено агентом актуализации сведений о поддержке (ЛР4). */

nrel_latest_version
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[последняя версия*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[latest version*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_operating_system_release;
=> nrel_second_domain: file;
=> nrel_definitional_domain:
	...
	(*
	<= nrel_combination:
		{
			concept_operating_system_release;
			file
		};;
	*);
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (последняя версия*)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Последняя версия* - отношение, связывающее выпуск операционной системы с номером его последнего обновления.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_operating_system_release;
			file
		};;
	*);;
