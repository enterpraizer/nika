/* Понятие введено агентом актуализации сведений о поддержке (ЛР4). */

concept_supported_operating_system
<- sc_node_class;
<= nrel_inclusion:
	concept_operating_system;
=> nrel_main_idtf:
	[поддерживаемая операционная система]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[supported operating system]
	(* <- lang_en;; *);
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (поддерживаемая операционная система)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Поддерживаемая операционная система - операционная система, актуальный выпуск которой на текущую дату не достиг даты окончания поддержки.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_operating_system;
			concept_operating_system_release
		};;
	*);;
