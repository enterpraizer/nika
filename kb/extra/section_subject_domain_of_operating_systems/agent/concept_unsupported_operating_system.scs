/* Понятие введено агентом актуализации сведений о поддержке (ЛР4). */

concept_unsupported_operating_system
<- sc_node_class;
<= nrel_inclusion:
	concept_operating_system;
=> nrel_main_idtf:
	[операционная система с завершённой поддержкой]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[unsupported operating system]
	(* <- lang_en;; *);
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (операционная система с завершённой поддержкой)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Операционная система с завершённой поддержкой - операционная система, актуальный выпуск которой на текущую дату уже прошёл дату окончания поддержки.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_operating_system;
			concept_operating_system_release
		};;
	*);;
