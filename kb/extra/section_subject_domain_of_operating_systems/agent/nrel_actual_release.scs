<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[актуальный выпуск*]
	(* <- lang_ru;; *);
=> nrel_main_idtf:
	[actual release*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_operating_system;
=> nrel_second_domain: concept_operating_system_release;
=> nrel_definitional_domain:
	...
	(*
	<= nrel_combination:
		{
			concept_operating_system;
			concept_operating_system_release
		};;
	*);
<- rrel_key_sc_element:
	...
	(*
	=> nrel_main_idtf:
		[Опр. (актуальный выпуск*)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Актуальный выпуск* - отношение, связывающее операционную систему с её последним выпуском, сведения о котором погружены в базу знаний.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
		{
			concept_operating_system;
			concept_operating_system_release
		};;
	*);;
