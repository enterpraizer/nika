		[Опр. (дата получения сведений*)]
		(* <- lang_ru;; *);;
	<- definition;;
	<= nrel_sc_text_translation:
		...
		(*
		-> rrel_example:
			[Дата получения сведений* - отношение, связывающее выпуск операционной системы с датой, когда сведения о нём были получены из внешнего источника и погружены в базу знаний.]
			(* <- lang_ru;; *);;
		*);;
	<= nrel_using_constants:
